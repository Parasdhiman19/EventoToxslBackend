# =============================================================================
# Evento Backend Environment Variables Template
# =============================================================================

# Django Core & Security
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Database (Leave blank for local SQLite, or set postgres connection string)
DATABASE_URL=

# Redis Cloud (For WebSockets & Live Stream Notifications)
REDIS_URL=redis://default:password@host:port

# Frontend URL & CORS Handshake
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary CDN Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (Sendinblue) Email Service
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_NAME=Evento
BREVO_SENDER_EMAIL=your_email@domain.com

# PayPal Sandbox / Live Credentials
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
